#!/bin/bash
set -u
unavailable() { printf '%s\n' 'dry-run observation unavailable' >&2; exit 125; }
url=${STAGEKEEPER_EVAL_OBSERVER:-}
[[ $url =~ ^http://127\.0\.0\.1:[0-9]+/[a-f0-9-]{36}$ ]] || unavailable
method=POST
if [[ $# == 1 && $1 == --check-observer ]]; then method=GET; elif [[ $# != 0 ]]; then unavailable; fi
reply=$(/usr/bin/curl -q --silent --fail --noproxy '*' --connect-timeout 3 --max-time 70 --request "$method" -- "$url") || unavailable
if [[ $method == GET ]]; then printf '%s\n' "$reply"; exit 0; fi
status=${reply%%$'\n'*}
[[ $reply == *$'\n'* && $status =~ ^(0|[1-9][0-9]{0,2})$ && $status -le 255 ]] || unavailable
printf '%s\n' "${reply#*$'\n'}"
exit "$status"
