generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String          @id @default(cuid())
  githubId  Int             @unique
  login     String
  createdAt DateTime        @default(now())
  subscription Subscription?
  ownerTokens  OwnerToken[]
  userTokens   UserToken[]
  projectAvailabilityVersion Int @default(0)
  usageWindowStartedAt DateTime?
  usageRunCount Int @default(0)
  ownedProjects Project[] @relation("ProjectOwner")
  projectAvailabilityEvents ProjectAvailabilityEvent[]
  requestRateWindows RequestRateWindow[]
  githubConnection GitHubConnection?
  githubConnectAttempts GitHubConnectAttempt[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String
  source    String   @default("manual")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  repo         String
  branch       String
  language     String          @default("ko")
  executorKind String          @default("local")
  commandIssue Int?
  runbookVersion String?
  autoScoutEnabled Boolean     @default(true)
  autoProposeEnabled Boolean   @default(true)
  defaultPipelineId String?
  workPipelineId String?
  workAutomationPaused Boolean @default(false)
  runnerPausedAt DateTime?
  runner       Runner?
  createdAt    DateTime        @default(now())
  tokens       ProjectToken[]
  workspaces   Workspace[]
  backlog      BacklogItem[]
  board        BoardItem[]
  commands     Command[]
  runs         AgentRun[]
  ownerTokens  OwnerToken[]
  pipelineVersions PipelineVersion[]
  pipelines    Pipeline[]      @relation("ProjectPipelines")
  defaultPipeline Pipeline?    @relation("ProjectDefaultPipeline", fields: [defaultPipelineId], references: [id], onDelete: SetNull)
  pipelineRules PipelineRule[]
  workRuns PipelineWorkRun[]
  ownerUserId   String
  repoOwner     String
  available     Boolean   @default(true)
  disconnectedAt DateTime?
  lastSelectedAt DateTime?
  lastSyncedAt  DateTime?
  requestRateWindows RequestRateWindow[]
  ownerUser     User      @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([ownerUserId, available])
  @@index([ownerUserId, disconnectedAt])
}

model Runner {
  projectId  String   @id
  client     String   @default("claude")
  session    String
  tokenId    String
  mode       String
  host       String
  branch     String?
  permission String?
  autostart  Boolean  @default(false)
  state      String
  waitReason String?
  lastResult String?
  lastLog    String?
  stopReason String?
  startedAt  DateTime
  seenAt     DateTime
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RequestRateWindow {
  scope       String
  subjectId   String
  ownerUserId String
  projectId   String?
  startedAt   DateTime
  count       Int
  owner       User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([scope, subjectId])
  @@index([ownerUserId])
  @@index([projectId])
}

model ProjectAvailabilityEvent {
  id                  String   @id @default(cuid())
  ownerUserId         String
  version             Int
  actor               String
  reason              String
  targetProjectId     String?
  fromPlan            String?
  toPlan              String?
  addedProjectIds     String[]
  removedProjectIds   String[]
  availableProjectIds String[]
  basis               String?
  at                   DateTime @default(now())
  ownerUser            User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, version])
  @@index([ownerUserId, at])
}

model ProjectToken {
  id        String    @id @default(cuid())
  projectId String
  hash      String    @unique
  label     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?
  lastUsedAt DateTime?
  usageTrackingStartedAt DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OwnerToken {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  hash      String    @unique
  label     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?
  lastUsedAt DateTime?
  usageTrackingStartedAt DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([projectId, userId])
}

model UserToken {
  id        String    @id @default(cuid())
  userId    String
  hash      String    @unique
  label     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?
  lastUsedAt DateTime?
  usageTrackingStartedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  projectId String
  wsId      String
  path      String
  agent     String
  verify    String[]
  knowledge String?
  readOnly  String[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, agent])
}

model BacklogItem {
  id        String      @id @default(cuid())
  projectId String
  key       String
  title     String
  area      String
  source    String
  createdAt DateTime    @default(now())
  removedAt DateTime?
  type      String?
  typeSetBy String?
  addedBy   String      @default("owner")
  addedByRunId String?
  removedReason String?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board     BoardItem[]
  @@unique([projectId, key])
}

model BoardItem {
  id            String            @id @default(cuid())
  projectId     String
  backlogItemId String
  agent         String
  status        String
  reason        String
  selectionDecision Json?
  results       String[]
  validation    String?
  acceptedAt    DateTime?
  planPath      String?
  planCommit    String?
  proposedOn    DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  discardedAt   DateTime?
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlogItem   BacklogItem       @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)
  events        TransitionEvent[]
  reports       Report[]
  acceptanceFailures AcceptanceFailure[]
  currentRunId  String?           @unique
  run           PipelineRun?      @relation("CurrentPipelineRun", fields: [currentRunId], references: [id], onDelete: SetNull)
  pipelineRuns  PipelineRun[]     @relation("ItemPipelineRuns")
  @@index([projectId, status])
}

model AcceptanceFailure {
  id          String    @id @default(cuid())
  boardItemId String
  checks      Int[]
  note        String
  path        String?
  commit      String?
  actorId     String?
  at          DateTime  @default(now())
  clearedAt   DateTime?
  boardItem   BoardItem @relation(fields: [boardItemId], references: [id], onDelete: Cascade)

  @@index([boardItemId, clearedAt])
}

model TransitionEvent {
  id          String    @id @default(cuid())
  boardItemId String
  from        String?
  to          String?
  actor       String
  actorId     String?
  channel     String?
  note        String?
  at          DateTime  @default(now())
  boardItem   BoardItem @relation(fields: [boardItemId], references: [id], onDelete: Cascade)
}

model Report {
  qa          Json?
  isAcceptance Boolean?
  id          String    @id @default(cuid())
  boardItemId String
  agentRunId  String?
  actor       String
  path        String
  commit      String
  at          DateTime  @default(now())
  boardItem   BoardItem @relation(fields: [boardItemId], references: [id], onDelete: Cascade)
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  @@index([agentRunId])
}

model Template {
  lang      String
  path      String
  body      String
  updatedAt DateTime @updatedAt
  @@id([lang, path])
}

model Command {
  id        String    @id @default(cuid())
  projectId String
  kind      String
  body      String
  status    String    @default("queued")
  createdAt DateTime  @default(now())
  ackedAt   DateTime?
  doneAt    DateTime?
  summary   String?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id        String         @id @default(cuid())
  projectId String
  agent     String
  key       String?
  tokenId   String
  revision  Int            @default(0)
  stepId    String
  refused   Int            @default(0)
  openedAt  DateTime       @default(now())
  closedAt  DateTime?
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps     AgentRunStep[]
  pipelineRunId String?
  pipelineEntryId String?
  workRunId String?
  workEntryId String?
  workRun PipelineWorkRun? @relation(fields: [workRunId], references: [id], onDelete: Cascade)
  pipelineRun PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([projectId, pipelineRunId, pipelineEntryId, agent, closedAt], map: "AgentRun_pipeline_entry_dispatch_idx")
  @@index([projectId, agent, key, closedAt])
  @@index([tokenId])
  @@index([workRunId, workEntryId])
}

model AgentRunStep {
  id      String   @id @default(cuid())
  runId   String
  stepId  String
  outcome String
  note    String?
  callerTokenId String?
  receiptRevision Int?
  accepted Boolean?
  at      DateTime @default(now())
  run     AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@index([callerTokenId, at])
  @@index([at])
}

model PipelineVersion {
  id         String    @id @default(cuid())
  projectId  String
  pipelineId String
  version    Int
  nodes      String[]
  gates      String[]
  format     String?
  selectionPolicy String?
  createdAt  DateTime  @default(now())
  createdBy  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  runs       PipelineRun[]
  workRuns   PipelineWorkRun[]
  @@unique([projectId, version])
  @@index([pipelineId, version])
}

model PipelineRun {
  id          String          @id @default(cuid())
  boardItemId String
  createdAt   DateTime        @default(now())
  startedBy   String?
  inputReportId String?
  versionId   String
  entryId     String?
  agentRuns   AgentRun[]
  node        String
  enteredAt   DateTime        @default(now())
  closedAt    DateTime?
  boardItem   BoardItem       @relation("ItemPipelineRuns", fields: [boardItemId], references: [id], onDelete: Cascade)
  currentFor  BoardItem?      @relation("CurrentPipelineRun")
  version     PipelineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  @@index([boardItemId, createdAt])
}

model PipelineWorkRun {
  id String @id @default(cuid())
  projectId String
  versionId String
  node String
  entryId String
  inputKey String
  waitReason String?
  assignedBoardItemId String?
  approvals           Json     @default("[]")
  createdAt DateTime @default(now())
  closedAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version PipelineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]
  @@index([projectId, closedAt, createdAt])
}

model Pipeline {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  createdAt   DateTime  @default(now())
  createdBy   String
  archivedAt  DateTime?
  project     Project   @relation("ProjectPipelines", fields: [projectId], references: [id], onDelete: Cascade)
  defaultOf   Project[] @relation("ProjectDefaultPipeline")
  definitions PipelineDefinition[]
  versions    PipelineVersion[]
  rules       PipelineRule[]
  @@index([projectId, archivedAt])
}

model PipelineDefinition {
  id         String   @id @default(cuid())
  pipelineId String
  version    Int
  steps      String[]
  gates      String[]
  selectionPolicy String?
  createdAt  DateTime @default(now())
  createdBy  String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  @@unique([pipelineId, version])
}

model PipelineRule {
  projectId  String
  type       String
  pipelineId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  @@id([projectId, type])
}

model GitHubConnection {
  userId String @id
  githubId String @unique
  revision Int @default(0)
  tokenVersion Int @default(0)
  accessToken String?
  refreshToken String?
  accessExpiresAt DateTime?
  refreshExpiresAt DateTime?
  revokedAt DateTime?
  refreshLeaseId String?
  refreshLeaseExpiresAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  installations GitHubInstallation[]
}

model GitHubConnectAttempt {
  id String @id
  flowId String
  userId String
  browserHash String
  stateHash String @unique
  kind String
  status String @default("pending")
  expectedRevision Int
  verifier String?
  draft String?
  outcome String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, browserHash, createdAt])
  @@index([expiresAt])
}

model GitHubInstallation {
  userId String
  installationId String
  connection GitHubConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, installationId])
  @@index([installationId])
}

model GitHubWebhookDelivery {
  id String @id
  expiresAt DateTime

  @@index([expiresAt])
}
